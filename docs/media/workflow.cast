[14.797108, "o", "\r\n"]
[18.001293, "o", "\u001b[2J\u001b[H# 2 / 4  COPY THE FOLDER\r\n"]
[18.001361, "o", "\r\n$ mkdir -p shared\r\n"]
[18.809172, "o", "\r\n"]
[20.012467, "o", "$ cp -a install/example-libraries shared/toolchain\r\n"]
[20.840271, "o", "\r\n"]
[22.044104, "o", "# Make the original path unavailable to check relocation.\r\n\r\n$ mv install/example-libraries install/original-hidden\r\n"]
[22.85163, "o", "\r\n"]
[26.058051, "o", "\u001b[2J\u001b[H# 3 / 4  ACTIVATE THE COPY\r\n\r\n# Leave the builder environment; keep the host compiler and CMake.\r\n\r\n$ deactivate\r\n"]
[26.861877, "o", "\r\n"]
[28.065531, "o", "$ source shared/toolchain/activate\r\n"]
[28.874098, "o", "\r\n"]
[30.076816, "o", "$ command -v toolchain || echo \"No builder CLI on PATH\"\r\n"]
[30.880081, "o", "No builder CLI on PATH\r\n\r\n"]
[34.085996, "o", "\u001b[2J\u001b[H# 4 / 4  COMPILE AND RUN AN APPLICATION\r\n\r\n$ cmake -S examples/hello -B build/hello --log-level=ERROR\r\n"]
