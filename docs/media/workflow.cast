[0.006478, "o", "\u001b[2J\u001b[H# 1 / 4  BUILD THE LIBRARIES\r\n\r\n"]
[0.00655, "o", "# fmt + spdlog; host compiler; sources already cached.\r\n\r\n$ toolchain build --config examples/library.yaml --jobs 4 --quiet --locked\r\n"]
[1.01382, "o", "[1/2] Building fmt 11.2.0\r\n"]
